[run]
branch = true
source = app
omit =
    app/__init__.py
    app/main.py
    app/notifications/mail.py
    app/notifications/scheduler.py

[report]
precision = 1
show_missing = true
skip_covered = false
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if TYPE_CHECKING:
    if __name__ == .__main__.:
exclude_also =
    \.\.\.
fail_under = 80
skip_empty = true

[html]
directory = htmlcov
