# API-only Dockerfile — sibling of backend/Dockerfile, intended for the
# Vercel (frontend) + Render (backend) split deploy. No SPA build stage.
#
# Build context: ./backend/  (Render resolves `dockerfilePath:
# ./Dockerfile.api` relative to the build context, and Render's build
# context for a blueprint service is `rootDir`; setting both to
# ./backend/ keeps things simple. If you change rootDir on Render to ".",
# also switch dockerfilePath to ../Dockerfile.api.)
#
# This file is for the SPLIT deploy only. The original backend/Dockerfile
# remains the canonical mono-host (API + SPA) image used by Render's
# single-service deploy, Cloudflare Containers, etc.

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libpq-dev libmagic1 curl ca-certificates tini \
    && rm -rf /var/lib/apt/lists/*

# All paths below are ./backend/-relative (the build context).
COPY pyproject.toml /app/pyproject.toml
COPY alembic.ini /app/alembic.ini
COPY alembic /app/alembic
COPY app/__init__.py /app/app/__init__.py
COPY app/api /app/app/api
COPY app/core /app/app/core
COPY app/db /app/app/db
COPY app/models /app/app/models
COPY app/notifications /app/app/notifications
COPY app/realtime /app/app/realtime
COPY app/schemas /app/app/schemas
COPY app/scoring /app/app/scoring
COPY app/services /app/app/services
COPY app/storage /app/app/storage
COPY scripts /app/scripts

# Sanity-check: fail the build loud if the storage Python package is
# missing (e.g. if app/storage/ wasn't tracked in git).
RUN test -f /app/app/storage/__init__.py \
 && test -f /app/app/storage/base.py \
 && test -f /app/app/storage/local.py \
 && echo "storage package present: $(ls /app/app/storage)"

RUN pip install --upgrade pip && pip install -e "/app[api]"

RUN mkdir -p /app/storage/files /app/storage/avatars /app/storage/backups

RUN useradd --create-home --uid 10001 --shell /bin/bash app \
    && chown -R app:app /app
USER app

ENV PORT=8080
EXPOSE 8080

ENTRYPOINT ["/usr/bin/tini", "--"]

# Honour $PORT. Run migrations on every boot.
CMD ["bash", "-lc", "alembic upgrade head && exec python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers"]
