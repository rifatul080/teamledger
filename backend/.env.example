# ----- TeamLedger backend -----
# Copy this file to .env and fill in the values you need.

# ---- runtime ----
APP_ENV=development
SECRET_KEY=dev-secret-change-me

# ---- database ----
# SQLite (dev): DATABASE_URL=sqlite:///./storage/teamledger.db
# Neon (prod): DATABASE_URL=postgresql://user:pass@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./storage/teamledger.db

# ---- mailer ----
# console (dev), smtp, or resend
MAIL_BACKEND=console
MAIL_FROM=teamledger@example.org
SMTP_HOST=maildev
SMTP_PORT=1025

# Resend (transactional email). Sign up at https://resend.com — free tier:
# 100 emails/day, 3,000/month. Paste the API key here; the from address
# must be a verified domain in Resend's dashboard.
RESEND_API_KEY=
RESEND_FROM=TeamLedger <noreply@teamledger.app>

# ---- public base url ----
# Used in the verification + password reset emails.
PUBLIC_BASE_URL=http://localhost:5173

# ---- CORS ----
# Comma-separated list of origins allowed to make credentialed requests.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- file storage ----
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./storage/files
FILE_MAX_BYTES=104857600  # 100 MiB

# ---- avatars ----
AVATAR_LOCAL_ROOT=./storage/avatars
AVATAR_MAX_BYTES=4194304  # 4 MiB

# ---- rate limits (per minute) ----
LOGIN_RATE_LIMIT_PER_MIN=10
SIGNUP_RATE_LIMIT_PER_MIN=5
RESET_RATE_LIMIT_PER_MIN=5
