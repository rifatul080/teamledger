// Cloudflare Worker config for TeamLedger — free-plan keep-alive cron ping.
//
// History: this Worker previously fronted a Containers deployment (a
// Durable Object proxying to the FastAPI container — see git history and
// src/container.ts). Containers require the paid Workers plan, so that
// architecture never deployed on the free plan and has been replaced:
//
//   scheduled() every 5 minutes →
//     GET https://teamledger-1.onrender.com/api/v1/health/db
//
// Render's Free compute plan spins down after 15 minutes without inbound
// traffic; this ping keeps the API instance — and the Neon database, via
// the health check's SELECT 1 — warm at zero cost. fetch() redirects the
// workers.dev URL to the production site (Vercel).
//
// Second (independent) keep-alive layer: .github/workflows/uptime.yml
// pings the same endpoint every 5 minutes from GitHub Actions.
{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "teamledger",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Cron triggers are supported on the free Workers plan.
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
