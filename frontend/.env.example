# Copy to `.env.local` for local dev (git-ignored) or set in Vercel
# project settings for production.
#
# Leave empty for same-origin deploys (local dev, Render/Fly/Railway mono-host).
# Set to the full URL of your backend when the frontend and API live on
# different origins (Vercel + Render split deploy).
# Example: VITE_API_BASE_URL=https://teamledger-api.onrender.com
VITE_API_BASE_URL=
