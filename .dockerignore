# Exclude from Docker build context (anything that would slow the
# COPY in the Dockerfile). The Dockerfile itself only COPYs what it
# needs; this file speeds the build by skipping upload of the rest.

# Node / frontend
frontend/node_modules
frontend/dist
frontend/.vite
frontend/coverage
frontend/tsconfig.tsbuildinfo

# Python / backend
backend/__pycache__
backend/**/__pycache__
backend/.pytest_cache
backend/.mypy_cache
backend/.ruff_cache
backend/.coverage
backend/htmlcov
backend/coverage.xml
backend/.venv
backend/venv
backend/.tox
backend/**.pyc
backend/**.pyo
backend/**.egg-info
backend/storage
backend/static
backend/*.db
backend/*.sqlite

# Git / IDE / OS
.git
.gitignore
.gitattributes
.idea
.vscode
.DS_Store
Thumbs.db

# Editor / tooling
.puku
.editorconfig
*.log

# Tests / docs
backend/tests
docs
*.md
!backend/**/*.md

# This file itself
.dockerignore
