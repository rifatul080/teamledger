# Exclude from Docker build context (anything that would slow the
# COPY in the Dockerfile). This file speeds the build by skipping upload
# of the rest. The build context is the repository root (wrangler runs
# `docker build` from the directory containing wrangler.jsonc).

# Node / frontend
frontend/node_modules
frontend/dist
frontend/.vite
frontend/coverage
frontend/tsconfig.tsbuildinfo

# Cloudflare Worker (used by wrangler, not by the backend Dockerfile)
src
node_modules
package.json
package-lock.json
tsconfig.json
wrangler.jsonc

# Python / backend
backend/__pycache__
backend/**/__pycache__
backend/.pytest_cache
backend/.mypy_cache
backend/.ruff_cache
backend/.coverage
backend/htmlcov
backend/coverage.xml
backend/.venv
backend/venv
backend/.tox
backend/**.pyc
backend/**.pyo
backend/**.egg-info
# Exclude the local-disk storage dir at the repo level (avatars, files,
# backups). The Python package at backend/app/storage/ is NOT excluded — it
# has a different path. The pattern below is path-anchored and won't match
# backend/app/storage.
backend/storage/**
backend/static
backend/*.db
backend/*.sqlite

# Git / IDE / OS
.git
.gitignore
.gitattributes
.idea
.vscode
.DS_Store
Thumbs.db

# Editor / tooling
.puku
.editorconfig
*.log

# Tests / docs
backend/tests
docs
*.md
!backend/**/*.md

# This file itself
.dockerignore
