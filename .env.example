# --- App ---
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+psycopg://teamledger:teamledger@db:5432/teamledger
# For local SQLite development without Docker:
# DATABASE_URL=sqlite:///./storage/teamledger.db
REDIS_URL=redis://redis:6379/0

# --- Auth ---
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=14
PASSWORD_RESET_TTL_MIN=30
INVITE_TTL_DAYS=7
LOGIN_RATE_LIMIT_PER_MIN=10
RESET_RATE_LIMIT_PER_MIN=5

# --- Storage ---
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./storage/files
FILE_MAX_BYTES=104857600   # 100 MB

# --- CORS / Origin ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Mail ---
MAIL_BACKEND=console
MAIL_FROM=teamledger@example.org
SMTP_HOST=maildev
SMTP_PORT=1025

# --- WebSocket ---
WS_HEARTBEAT_SECONDS=25

# --- Timezone default ---
DEFAULT_TIMEZONE=UTC

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
